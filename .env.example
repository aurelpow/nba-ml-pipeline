# Base settings (used for all envs unless overridden)
APP_ENV=dev

# Storage sink: bq or local
SAVE_MODE=bq

# GCP
GCP_PROJECT_ID=ml-nba-project
BIGQUERY_DATASET=nba_dataset

# Model registry (local folder or GCS prefix)
# MODEL_REGISTRY_URI=gs://your-bucket/models
MODEL_REGISTRY_URI=ml_dev/models
MODEL_FILENAME=best_lgbm_model.pkl

# Optional proxies for nba_api
# NBA_PROXY_USER=
# NBA_PROXY_PASS=

# Inference defaults
SEASON=2024-25
SEASON_TYPE=Regular Season
DATE=2025-05-01
DAYS_NUMBER=1
MODEL_PATH=ml_dev/models/best_lgbm_model.pkl

